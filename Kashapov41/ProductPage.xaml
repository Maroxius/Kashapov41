<Page x:Class="Kashapov41.Images.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kashapov41.Images"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1" Margin="0,0,0,5">
            <TextBlock Text="Кол-во __ из __" Name="amountCounter" Margin="0,0,15,0"></TextBlock>
            <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                <TextBlock Text="Поиск по наименованию"></TextBlock>
                <TextBox Width="150" Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                <RadioButton Content="По возрастанию стоимости" Name="RBtn_Asc" Checked="RBtn_Asc_Checked"></RadioButton>
                <RadioButton Content="По убыванию стоимости" Name="RBtn_Desc" Checked="RBtn_Desc_Checked"></RadioButton>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Фильтрация по скидке"></TextBlock>
                <ComboBox Width="150" Name="DiscountCombo" SelectionChanged="DiscountCombo_SelectionChanged">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>от 0 до 10%</TextBlock>
                    <TextBlock>от 10 до 15%</TextBlock>
                    <TextBlock>от 15 до 100%</TextBlock>

                </ComboBox>
            </StackPanel>
        </WrapPanel>
        <ListView Name="ProductListView" HorizontalContentAlignment="Stretch" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        
                        <Image Width="150" Grid.Column="0" Grid.RowSpan="4" Stretch="Uniform" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            Images\picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Orientation="Vertical" Grid.Column="1" Margin="15,0,0,0">
                            <TextBlock Text="{Binding ProductName}" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,25" FontWeight="Bold"></TextBlock>
                            <TextBlock Text="{Binding ProductDescription}" HorizontalAlignment="Left" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,5"></TextBlock>
                            <TextBlock Text="{Binding Manufacturer.ManufacturerName}" HorizontalAlignment="Left" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,10"></TextBlock>
                            <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" HorizontalAlignment="Left" FontSize="18" TextWrapping="Wrap"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Grid.Column="2">
                            <TextBlock Text="Скидка" HorizontalAlignment="Center" FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0:0}%}" HorizontalAlignment="Center" FontSize="40" Margin="0,30,0,0"></TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

</Page>
