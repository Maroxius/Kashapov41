<Page x:Class="Kashapov41.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kashapov41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Логин:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" FontSize="18"></TextBlock>
        <TextBlock Text="Пароль:" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" FontSize="18"></TextBlock>
        <StackPanel Name="CaptchaSP" Visibility="Hidden" Orientation="Vertical" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0">
            <TextBlock Text="Докажите, что вы не робот:" Margin="0,0,0,10" FontSize="14"></TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Name="Captcha1" FontSize="22" Margin="30,0,0,0"></TextBlock>
                <TextBlock Name="Captcha2" FontSize="22" Margin="0,5,0,0" TextDecorations="Strikethrough"></TextBlock>
                <TextBlock Name="Captcha3" FontSize="22" Margin="0,0,0,0" TextDecorations="Strikethrough"></TextBlock>
                <TextBlock Name="Captcha4" FontSize="22" Margin="0,15,0,0" TextDecorations="Strikethrough"></TextBlock>
            </StackPanel>
        </StackPanel>
        <TextBox Name="CaptchaTB" Visibility="Hidden" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150"></TextBox>
        <TextBox Name="LoginTB" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Margin="0,0,40,0"></TextBox>
        <TextBox Name="PasswordTB" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Margin="0,0,40,0"></TextBox>
        <Button Name="EnterBtn" Content="Войти" Grid.Row="3" Grid.Column="1" Click="EnterBtn_Click"></Button>
        <Button Name="EnterAsGuestBtn" Content="Войти как гость" Grid.Row="3" Grid.Column="0" Click="EnterAsGuestBtn_Click"></Button>
    </Grid>
</Page>
